# This repository is public. Anything matched here must never be committed.
# If you genuinely need to commit a matched file, force it deliberately:
#   git add -f <path>

# ---------- Terraform ----------

# Working directories
**/.terraform/
.terraform.lock.hcl.bak

# State: contains resource ids, subscription ids and sometimes plaintext secrets
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Plans: readable, and contain variable values
*.tfplan
*.tfplan.*

# Variable files that may contain environment-specific values
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# ---------- Credentials, keys and certificates ----------

*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# ---------- Kubernetes ----------

# A kubeconfig grants working access to the cluster it describes
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/
admin.conf

# Rendered manifests that may contain resolved secret values
secrets.yaml
secrets.yml
*-secret.yaml
*-secret.yml
*-secrets.yaml
*-secrets.yml

# ---------- Helm ----------

# Packaged charts and fetched dependencies
*.tgz
charts/*/charts/
# Per-environment values often carry connection details
values.local.yaml
values.*.local.yaml

# ---------- Cloud CLI state ----------

.azure/
.aws/
azureProfile.json
service-principal.json

# ---------- Local environment ----------

.env
.env.*
!.env.example

# ---------- Logs and scratch ----------

*.log
*.bak
*.tmp
tmp/
scratch/

# ---------- Editors ----------

.idea/
.vscode/

# ---------- OS ----------

.DS_Store
Thumbs.db

# ---------- Python ----------

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/
